{
  "name": "taskindex",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "precheck": "npm run -s preflight",
    "pretest": "npm run -s preflight",
    "predev": "npm run -s preflight",
    "pree2e": "npm run -s preflight",
    "presandbox": "npm run -s preflight",
    "dev": "node scripts/dev.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "sandbox": "node --import tsx scripts/sandbox.mts",
    "agent-cycle": "node --import tsx scripts/agent-cycle.mts",
    "bench": "node --import tsx scripts/bench-journal.ts",
    "unused-exports": "node scripts/unused-exports.mjs",
    "build": "vite build && tsdown",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "check": "npm run typecheck && npm run lint && npm run unused-exports && npm run format:check && npm run lint:shell && npm run build && npm run check:skin && npm run test",
    "check:skin": "node scripts/check-skin.mjs",
    "typecheck": "tsc --noEmit",
    "lint:shell": "bash deploy/lint-shell.sh",
    "lint": "oxlint src tests/unit tests/api tests/property tests/web tests/cli tests/e2e tests/deploy deploy/*.mjs deploy/drill/*.mjs scripts/gate.mjs scripts/dev.mjs scripts/setup-dev.mjs scripts/preflight.mjs scripts/sandbox.mts scripts/agent-cycle.mts scripts/unused-exports.mjs scripts/bench-journal.ts",
    "format": "oxfmt src tests/unit tests/api tests/property tests/web tests/cli tests/e2e tests/deploy deploy/*.mjs deploy/drill/*.mjs scripts package.json tsconfig.json vite.config.ts vitest.config.ts tsdown.config.ts",
    "format:check": "oxfmt --check src tests/unit tests/api tests/property tests/web tests/cli tests/e2e tests/deploy deploy/*.mjs deploy/drill/*.mjs scripts/gate.mjs scripts/dev.mjs scripts/setup-dev.mjs scripts/preflight.mjs scripts/sandbox.mts scripts/agent-cycle.mts scripts/unused-exports.mjs scripts/bench-journal.ts package.json tsconfig.json vite.config.ts vitest.config.ts tsdown.config.ts",
    "test": "vitest run",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:publish-reference": "TASKINDEX_E2E_ARTIFACT_DIR=docs/reference/v2-validation npm run -s e2e -- --project visual",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/admin.ts migrate",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli/index.ts",
    "admin": "node --env-file-if-exists=.env --import tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/passkey": "1.7.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.3",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.7",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.9.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "type": "module",
  "bin": {
    "taskindex": "dist/cli/index.js",
    "taskindex-admin": "dist/cli/admin.js"
  }
}
