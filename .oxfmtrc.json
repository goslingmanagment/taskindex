{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.db",
    "**/*.html",
    "**/*.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CLAUDE.md",
    "README.md",
    "bun.lock",
    "bun.lockb",
    "coverage/**",
    "data/**",
    "deploy/README.md",
    "dist/**",
    "docs/**",
    "drizzle/**",
    "issues.md",
    "node_modules/**",
    "package-lock.json",
    "playwright-report/**",
    "pnpm-lock.yaml",
    "public/**",
    "skills/**",
    "src/web/vendor/**",
    "test-results/**",
    "yarn.lock"
  ]
}
