# Copy outside git to a protected env file; replace empty required values.
# Invoke with: op run --env-file=/absolute/path/taskindex.env -- ./deploy/deploy.sh --image REF COMMIT
BASE_URL=
BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRET=op://VAULT/ITEM/FIELD
# TIMEZONE читается только `taskindex-admin migrate` при первой инициализации базы
# (bootstrap.sh); действующий пояс хранится в settings, позже переменная не читается.
TIMEZONE=Europe/Moscow
# LOG_LEVEL: debug|info|warn|error — порог JSON-лога сервера и admin-команд.
LOG_LEVEL=info
# «Войти через хаб» (src/server/hub-signin.ts). Пусто — выключен, вход только по паролю.
# HUB_SIGNIN_URL — имя хаба, куда уходит браузер; HUB_SIGNIN_KEY — свой ключ агента хаба
# с правом signin:taskindex (только для sso/redeem и sso/check, в журнал не пишется).
# HUB_SIGNIN_API_URL — куда сервер ходит за ответом (по умолчанию HUB_SIGNIN_URL);
# HUB_SIGNIN_CLIENT — имя клиента в WEB_SIGNIN_CLIENTS хаба (по умолчанию taskindex).
# Обратный адрес, зарегистрированный в хабе: <BASE_URL>/auth/hub/callback.
HUB_SIGNIN_URL=
# HUB_SIGNIN_URL=https://hub.gosling-agency.ru
HUB_SIGNIN_KEY=
# HUB_SIGNIN_KEY=op://VAULT/ITEM/credential
HUB_SIGNIN_API_URL=
HUB_SIGNIN_CLIENT=
TASKINDEX_VOLUME=taskindex_data
# TASKINDEX_IMAGE: тег готового образа с меткой org.opencontainers.image.revision —
# из CI (`docker save | ssh docker load`) или аварийной сборки `--build-here`.
# Нужен только при первой установке; дальше deploy.sh/compose.sh берут image, build,
# deployment и replicaUrl из deploy/.runtime/current.json поверх этого файла.
TASKINDEX_IMAGE=taskindex:local
TASKINDEX_BUILD=local
TASKINDEX_DEPLOYMENT=local-initial
LITESTREAM_REPLICA_URL=
# s3://BUCKET/EXCLUSIVE_TASKINDEX_PREFIX
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_FORCE_PATH_STYLE=false
LITESTREAM_HEARTBEAT_URL=
# Необязательно. Пусто = heartbeat выключен (текущее решение: копии снимает мак,
# deploy/pull-backup.sh). Если понадобится внешний dead-man switch: ping URL чека
# healthchecks.io (период 1 мин, grace 3 мин) — секрет, хранить в 1Password.
# LITESTREAM_HEARTBEAT_URL=op://VAULT/ITEM/ping-url
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY_ID=op://VAULT/ITEM/access-key-id
# AWS_SECRET_ACCESS_KEY=op://VAULT/ITEM/secret-access-key
# Ключ хаба агента (src/server/hub-agent-keys.ts): HUB_INTROSPECT_KEY — свой ключ хаба TaskIndex
# с правом introspect:agent_keys (может быть тот же, что HUB_SIGNIN_KEY, с этим правом); пусто —
# ключи хаба не принимаются. Адрес — HUB_INTROSPECT_URL, по умолчанию HUB_SIGNIN_API_URL или
# HUB_SIGNIN_URL. HUB_AGENTS — таблица владельца: код_агента_хаба=id_агента:read|propose|tasks|write
# через запятую; кода нет в таблице — ключ хаба получает отказ.
HUB_INTROSPECT_KEY=
HUB_INTROSPECT_URL=
HUB_AGENTS=
