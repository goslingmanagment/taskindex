# Copy outside git to a protected env file; replace empty required values.
# Invoke with: op run --env-file=/absolute/path/taskindex.env -- ./deploy/deploy.sh COMMIT
BASE_URL=
BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRET=op://VAULT/ITEM/FIELD
TIMEZONE=Europe/Moscow
LOG_LEVEL=info
TASKINDEX_VOLUME=taskindex_data
TASKINDEX_IMAGE=taskindex:local
TASKINDEX_BUILD=local
TASKINDEX_DEPLOYMENT=local-initial
LITESTREAM_REPLICA_URL=
# s3://BUCKET/EXCLUSIVE_TASKINDEX_PREFIX
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY_ID=op://VAULT/ITEM/access-key-id
# AWS_SECRET_ACCESS_KEY=op://VAULT/ITEM/secret-access-key
